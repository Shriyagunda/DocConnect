PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Provider-neutral SMS relay. It must accept POST JSON:
# { "to": "+15551234567", "message": "...", "notificationId": "...", "type": "appointment_confirmation" }
# Optional relay bearer token: SMS_WEBHOOK_TOKEN
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Only needed for the one-time data copy (npm run migrate:mongo)
MONGODB_URI=
